# AdvisingLog — Environment Variables Template
# ============================================================
# This project is split into frontend (Vite/React) and backend (Cloudflare Workers).
# For specific configuration details, see:
#   - frontend/.env.example (Frontend client variables)
#   - backend/.dev.vars.example (Backend Cloudflare Workers local dev variables)
# ============================================================

# ------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (frontend/.env.local)
# ------------------------------------------------------------
# Google OAuth Client ID (must match backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Backend API endpoint URL (localhost:8787 for dev, or Cloudflare Workers URL)
VITE_API_URL=http://localhost:8787

# Cloudinary Cloud Name for client-side uploads
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Cloudinary unsigned upload preset
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Super admin bootstrap email
VITE_SUPER_ADMIN_EMAIL=your-admin@example.com

# ------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (backend/.dev.vars)
# ------------------------------------------------------------
# Server-verified Google OAuth Client ID
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# 64-character hex secret for signing session tokens (openssl rand -hex 32)
SESSION_SECRET=replace-with-64-random-hex-characters

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Super Admin email address
SUPER_ADMIN_EMAIL=your-admin@example.com

# Cloudinary credentials (optional server-side)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional Google Workspace Gmail API credentials for notification delivery
GOOGLE_WORKSPACE_CLIENT_ID=your-oauth-client-id
GOOGLE_WORKSPACE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_WORKSPACE_REFRESH_TOKEN=your-mailbox-refresh-token
GOOGLE_WORKSPACE_SENDER=se.advisinglog@gmail.com
