# Frontend Environment Variables
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local or any file containing real credentials to Git.

# ─── Google OAuth ───────────────────────────────────────────────────────────
# Your Google OAuth 2.0 client ID from https://console.cloud.google.com/
# Used by the frontend to initiate Google Sign-In.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ─── Backend API ─────────────────────────────────────────────────────────────
# Base URL of the Cloudflare Workers backend API.
# For local development, the backend runs on port 8787 by default.
# For production, replace with your deployed Workers URL.
VITE_API_URL=http://localhost:8787

# ─── Cloudinary ──────────────────────────────────────────────────────────────
# Your Cloudinary cloud name (found in the Cloudinary Dashboard).
# Used to construct upload and delivery URLs for student documents and images.
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Your Cloudinary unsigned upload preset name.
# Create one in Cloudinary Dashboard → Settings → Upload → Upload Presets.
# Use an unsigned preset for direct browser uploads only.
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# ─── Super Admin ─────────────────────────────────────────────────────────────
# The Google account email address that is automatically granted the Admin role.
# Only one super-admin email is supported; set this to your admin account.
VITE_SUPER_ADMIN_EMAIL=your-admin@example.com
